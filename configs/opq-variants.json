{
  "datasets": [
    "yahoo-minilm-384-normalized",
    "arxiv-nomic-768-normalized"
  ],
  "seed": 1,
  "n_fit": 20000,
  "n_reconstruct": 1000,
  "n_eval": 1000,
  "k": [1, 10, 100],
  "metrics": ["recall", "mse_score", "mse_recon"],
  "methods": [
    {
      "name": "pq",
      "centroids": 256,
      "section_dim": [8, 4]
    },
    {
      "name": "opq_p",
      "centroids": 256,
      "section_dim": [8, 4]
    },
    {
      "name": "opq",
      "centroids": 256,
      "section_dim": [8, 4],
      "init": ["identity", "eigen"],
      "iters": [5, 15]
    }
  ]
}
